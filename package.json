{
  "name": "studywise-courses",
  "productName": "Studywise Courses",
  "version": "1.13.0",
  "description": "Bite-sized courses from your lecture slides and transcripts, plus flashcards and notes, powered by your local Claude Code.",
  "author": "Studywise",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.mobile.json",
    "test": "cross-env AI_MOCK=1 ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env AI_MOCK=1 ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "test:e2e": "npm run build && cross-env AI_MOCK=1 playwright test",
    "ai:smoke": "cross-env TSX_TSCONFIG_PATH=tsconfig.node.json ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs scripts/ai-smoke.ts",
    "ai:real-check": "cross-env TSX_TSCONFIG_PATH=tsconfig.node.json ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs scripts/real-check.ts",
    "ai:course-check": "cross-env TSX_TSCONFIG_PATH=tsconfig.node.json ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs scripts/course-real-check.ts",
    "icons": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "dist:arm64": "npm run build && electron-builder --config electron-builder.config.cjs --mac dmg:arm64 zip:arm64 --publish never",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win --publish never",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "mobile:build": "vite build --config vite.mobile.config.ts",
    "android:sync": "npm run mobile:build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/android-build.mjs",
    "android:run": "npm run android:sync && cap run android",
    "ios:sync": "npm run mobile:build && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "icons:ios": "electron scripts/make-ios-icon.cjs",
    "sync:demo": "cross-env TSX_TSCONFIG_PATH=tsconfig.node.json ELECTRON_RUN_AS_NODE=1 electron ./node_modules/tsx/dist/cli.mjs scripts/sync-demo.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/status-bar": "^8.0.4",
    "better-sqlite3": "^13.2.0",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "sql.js": "^1.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.15",
    "@electron/rebuild": "^4.2.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "diff": "^9.0.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.75.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
